{
  "name": "renderkit-2d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-native semantic 2D rendering, audit and repair",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "renderkit": "dist/packages/cli/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config apps/studio/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "dev": "vite --config apps/studio/vite.config.ts --host 0.0.0.0",
    "renderkit": "tsx packages/cli/src/index.ts",
    "demo": "npm run renderkit -- build examples/demo.json --target all --out artifacts/demo"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "commander": "^13.1.0",
    "image-size": "2.0.4",
    "jszip": "^3.10.1",
    "katex": "^0.19.1",
    "mathjax-full": "^3.2.2",
    "pptxgenjs": "^3.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.5",
    "@vitejs/plugin-react": "^4.7.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "image-size": "2.0.4"
  }
}
