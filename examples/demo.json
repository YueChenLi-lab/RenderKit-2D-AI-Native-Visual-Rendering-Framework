      ]
    },
    {
      "id": "summary",
      "type": "summary",
      "title": "Make every output inspectable",
      "keyMessage": "A useful MVP preserves meaning across formats and reports its limits.",
      "blocks": [
        {
          "id": "summary-points",
          "type": "text",
          "text": "01   Shared IR keeps content separate from presentation.\n\n02   Theme tokens travel across Web and PowerPoint.\n\n03   Audits detect measurable defects; repairs preserve data.\n\n04   Human review remains necessary for factual and aesthetic judgment.",
          "fontSize": 28
        }
      ],
      "speakerNotes": "Conclude with the distinction between layout validation and factual correctness. All numerical experiment values in this deck are simulated."
    }
